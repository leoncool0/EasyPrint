# EasyPrint Server Environment Configuration
# Copy this file to .env and modify as needed

# Security
SECRET_KEY=your-secret-key-change-this-in-production

# Debug mode
DEBUG=false

# Server ports (usually no need to change in Docker)
HTTP_HOST=0.0.0.0
HTTP_PORT=8080
TCP_HOST=0.0.0.0
TCP_PORT=9100
UDP_PORT=20000